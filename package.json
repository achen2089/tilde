{
  "name": "tilde-md",
  "version": "0.1.0",
  "description": "A fast, plugin-powered TUI markdown workbench",
  "type": "module",
  "bin": {
    "tilde": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "tui",
    "cli",
    "templates",
    "scaffold",
    "skill",
    "agent",
    "mermaid"
  ],
  "author": "achen2089",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "gpt-tokenizer": "^2.8.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.18",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
